# Seccomp policy for Samsung C2 Codec with mremap support
futex: 1
ioctl: 1
close: 1
dup: 1
ppoll: 1
mprotect: 1
mmap: 1
getuid: 1
getrlimit: 1
fstat: 1
newfstatat: 1
fstatfs: 1
memfd_create: 1
fsetxattr: 1
ftruncate: 1
mremap: 1
munmap: 1
prctl: 1
madvise: 1
gettid: 1
getpid: 1
write: 1
read: 1
exit: 1
exit_group: 1
sigreturn: 1
restart_syscall: 1
clock_gettime: 1
sched_yield: 1
