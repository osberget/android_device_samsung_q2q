service boringssl_self_test32_vendor /vendor/bin/boringssl_self_test32
    override
    disabled
    user root

service boringssl_self_test64_vendor /vendor/bin/boringssl_self_test64
    override
    disabled
    user root

service boringssl_self_test_apex32 /apex/com.android.conscrypt/bin/boringssl_self_test32
    override
    disabled
    user root

service boringssl_self_test_apex64 /apex/com.android.conscrypt/bin/boringssl_self_test64
    override
    disabled
    user root

service sec-camera-provider-4-0 /vendor/bin/hw/vendor.samsung.hardware.camera.provider@4.0-service_64
    override
    class hal
    user system

service ril-daemon /vendor/bin/hw/rild
    override
    class main
    user radio
    group radio cache inet misc audio log oem_2901 system drmrpc vpn readproc wakelock net_admin
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW SYS_ADMIN CHOWN SYS_TIME

service vendor.qti.hardware.display.composer /vendor/bin/hw/vendor.qti.hardware.display.composer-service
    override
    user system
    group graphics drmrpc
    capabilities SYS_ADMIN SYS_NICE SYS_RESOURCE SYS_RAWIO

service vendor.adsprpcd /vendor/bin/adsprpcd
    override
    disabled
    user system
    group system

service vendor.cdsprpcd /vendor/bin/cdsprpcd
    override
    user system
    group system

service vendor.audioadsprpcd_audiopd /vendor/bin/audioadsprpcd audiopd
    override
    user system
    group system audio

service samsung-software-media-c2-hal-1-0 /vendor/bin/hw/samsung.software.media.c2@1.0-service
    override
    disabled
    user root

service vendor-qti-media-c2-hal-1-0 /vendor/bin/hw/vendor.qti.media.c2@1.0-service
    override
    disabled
    user mediacodec

service hermesd /vendor/bin/hermesd /data/vendor/gatekeeper
    override
    class hal
    user system
    socket hermes_secnvm stream 660 system system
    group system 5678
    capabilities WAKE_ALARM
    seclabel u:r:su:s0

service vendor.fkeymaster-default /vendor/bin/vendor.samsung.hardware.security.fkeymaster-service
    override
    interface aidl vendor.samsung.hardware.security.fkeymaster.ISehFkeymaster/default
    class early_hal
    user system
    group system
    seclabel u:r:su:s0
