<resources>
    <!-- Is the fingerprint sensor located on the power button? -->
    <bool name="config_is_powerbutton_fps">true</bool>

    <!-- Maximum number of fingerprints per user -->
    <integer name="config_fingerprintMaxTemplatesPerUser">5</integer>

    <!-- Device states corresponding to the device being folded (CLOSE = 0) -->
    <integer-array name="config_foldedDeviceStates">
        <item>0</item>
    </integer-array>

    <!-- Default peak refresh rate -->
    <integer name="config_defaultPeakRefreshRate">120</integer>
</resources>
