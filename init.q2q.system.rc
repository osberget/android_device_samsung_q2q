on early-init
    loglevel 7
    write /proc/sys/kernel/printk "7 7 7 7"
    write /dev/kmsg "=== INIT SECOND STAGE STARTED SUCCESSFULLY ==="
    write /metadata/boot_kmsg.txt "=== STAGE 2 INIT STARTED ===\n"
    write /sys/fs/selinux/enforce 0
    write /sys/module/subsystem_restart/parameters/disable_restart_work 2559098349
    write /sys/module/msm_subsystem_restart/parameters/disable_restart_work 2559098349
    setprop sys.usb.configfs 1
    setprop sys.usb.controller a600000.dwc3
    setprop sys.usb.config adb
    setprop persist.sys.usb.config adb
    setprop ro.hardware.egl adreno
    setprop ro.hardware.vulkan adreno
    setprop ro.board.platform lahaina
    setprop persist.graphics.egl adreno
    mkdir /spu 0771 system system
    mkdir /efs 0771 radio radio
    mkdir /sec_efs 0771 radio radio
    mkdir /keyrefuge 0771 system system
    chown radio radio /efs
    chown radio radio /sec_efs
    chown radio radio /mnt/vendor/efs

on init
    write /dev/kmsg "=== Q2Q DEBUG: ON INIT REACHED ==="
    write /metadata/boot_kmsg.txt "=== ON INIT REACHED ===\n"
    setprop sys.usb.config adb
    chmod 0666 /dev/dri/card0
    chmod 0666 /dev/dri/renderD128
    chown system graphics /dev/dri/card0
    chown system graphics /dev/dri/renderD128
    chmod 0666 /dev/ion
    chmod 0666 /dev/dma_heap/system

on post-fs
    write /dev/kmsg "=== Q2Q DEBUG: ON POST-FS REACHED ==="
    write /cache/boot_log.txt "POST-FS REACHED\n"
    write /metadata/boot_kmsg.txt "=== ON POST-FS REACHED ===\n"
    start q2q_vendor_rw
    mount none /system/etc/media_codecs.xml /vendor/etc/media_codecs.xml bind
    mount none /system/etc/audio_policy_configuration.xml /vendor/etc/audio_policy_configuration.xml bind
    mount none /system/etc/devicestate/device_state_configuration.xml /vendor/etc/devicestate/device_state_configuration.xml bind
    mkdir /odm 0755 root root
    mount tmpfs tmpfs /odm mode=0755,size=64M
    mkdir /odm/lib 0755 root root
    mkdir /odm/lib/bt 0755 root root
    mkdir /odm/lib64 0755 root root
    mkdir /odm/lib64/bt 0755 root root
    exec - root root -- /system/bin/sh -c "cp -r /system/etc/q2q_bt_libs32/* /odm/lib/bt/ 2>/dev/null; cp -r /system/etc/q2q_bt_libs/* /odm/lib64/bt/ 2>/dev/null; chmod 0644 /odm/lib/bt/*.so /odm/lib/bt/hw/*.so /odm/lib64/bt/*.so /odm/lib64/bt/hw/*.so; chmod 0755 /odm/lib64/bt/q2q_bt_audio_service_vendor /odm/lib/bt/libq2q_hidl_shim.so; restorecon_recursive /odm"
    mount none /odm/lib/bt/hw/audio.bluetooth.default.so /vendor/lib/hw/audio.bluetooth.default.so bind
    mount none /odm/lib64/bt/hw/audio.bluetooth.default.so /vendor/lib64/hw/audio.bluetooth.default.so bind
    mount none /odm/lib64/bt/q2q_bt_audio_service_vendor /system_ext/bin/q2q_bt_audio_service bind
    mount none /system/etc/q2q_bt_audio_manifest.xml /vendor/etc/vintf/manifest/sec_c2_manifest_default0.xml bind
    mkdir /odm/bin 0755 root root
    exec - root root -- /system/bin/sh -c "cp /vendor/bin/hw/vendor.samsung.hardware.camera.provider@4.0-service_64 /odm/bin/sec-cam-provider-orig 2>/dev/null; cp /system/etc/q2q_camera/q2q_cam_provider_wrapper /odm/bin/q2q_cam_provider_wrapper 2>/dev/null; chmod 0755 /odm/bin/sec-cam-provider-orig /odm/bin/q2q_cam_provider_wrapper 2>/dev/null; chcon u:object_r:hal_camera_default_exec:s0 /odm/bin/sec-cam-provider-orig /odm/bin/q2q_cam_provider_wrapper 2>/dev/null"
    mount none /odm/bin/q2q_cam_provider_wrapper /vendor/bin/hw/vendor.samsung.hardware.camera.provider@4.0-service_64 bind
    exec u:r:vendor_modprobe:s0 root root -- /system/bin/sh /system/bin/init.q2q.modules.sh
    mount none /system/etc/seccomp_policy/samsung.software.media.c2@1.0-policy /vendor/etc/seccomp_policy/samsung.software.media.c2-base-policy bind
    mount none /system/etc/seccomp_policy/samsung.software.media.c2@1.0-policy /vendor/etc/seccomp_policy/samsung.software.media.c2-ext-policy bind
    mkdir /sys/fs/cgroup/apps 0755 system system
    mkdir /sys/fs/cgroup/system 0755 system system
    mkdir /metadata/bootlogs 0777 root root
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    setprop sys.usb.config adb
    start adbd

on boot
    write /dev/kmsg "=== Q2Q DEBUG: ON BOOT REACHED ==="
    write /cache/boot_log.txt "BOOT REACHED\n"
    write /metadata/boot_kmsg.txt "=== ON BOOT REACHED ===\n"
    write /sys/fs/selinux/enforce 0
    setprop sys.usb.config adb
    setprop persist.sys.usb.config adb
    setprop ro.adb.secure 0
    start adbd
    exec u:r:su:s0 root root -- /system/bin/ip link set rmnet_ipa0 up
    exec u:r:init:s0 root root -- /system/bin/sh /system/bin/init.q2q.usb.sh
    # Disable SPSS watchdog reboot loop for all subsys nodes
    write /sys/bus/msm_subsys/devices/subsys0/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys1/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys2/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys3/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys4/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys5/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys6/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys7/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys8/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys9/restart_level "SYSTEM"
    write /sys/bus/msm_subsys/devices/subsys10/restart_level "SYSTEM"

on early-boot
    mkdir /data/vendor/gatekeeper 0770 system system
    exec u:r:su:s0 root root -- /system/bin/sh -c "mkdir -p /data/vendor/gatekeeper && chown system:system /data/vendor/gatekeeper && chmod 0770 /data/vendor/gatekeeper"

on post-fs-data
    setprop sys.q2q.postfs_ok 1
    write /dev/kmsg "=== Q2Q DEBUG: ON POST-FS-DATA REACHED ==="
    write /cache/boot_log.txt "POST-FS-DATA REACHED\n"
    mkdir /data/media 0770 1023 1023
    mkdir /data/media/0 0770 1023 1023
    mkdir /data/vendor/gatekeeper 0770 system system
    mkdir /data/media/0/Android 0770 1023 1023
    mkdir /data/media/0/Android/data 0770 1023 1023
    mkdir /data/media/0/Android/media 0770 1023 1023
    mkdir /data/media/0/Android/obb 0770 1023 1023
    mkdir /data/vendor/log/wifi 0770 wifi wifi
    chown radio system /efs
    chown radio system /mnt/vendor/efs
    chmod 0775 /efs
    chmod 0775 /mnt/vendor/efs
    chown 1023 1023 /data/media
    chown 1023 1023 /data/media/0
    restorecon_recursive /data/media
    start q2q_modules_loader

service q2q_vendor_rw /system/bin/sh /system/bin/init.q2q.vendor_rw.sh
    class early_hal
    user root
    group root
    oneshot
    seclabel u:r:su:s0

service q2q_modules_loader /system/bin/sh /system/bin/init.q2q.modules.sh
    class early_hal
    user root
    group root
    oneshot
    seclabel u:r:vendor_modprobe:s0

on property:vendor.all.modules.ready=1
    write /sys/kernel/boot_adsp/boot 1
    start vendor.audioadsprpcd_audiopd
    start vendor.cdsprpcd
    start sec-camera-provider-4-0
    stop vendor.audio-hal
    stop audioserver
    start vendor.audio-hal
    start audioserver
    start cameraserver
    start network_config
    start sim_config

service spss_disable /system/bin/sh -c "for f in /sys/bus/msm_subsys/devices/subsys*/name; do if grep -q spss \$f; then dir=\$(dirname \$f); echo SYSTEM > \$dir/restart_level; fi; done"
    class early_hal
    user root
    group root
    oneshot

service boot_logger /system/bin/sh -c "while true; do dmesg > /cache/kmsg.txt; sleep 2; done"
    class early_hal
    user root
    group root
    seclabel u:r:su:s0
    disabled

service persistent_logcat /system/bin/logcat -b all -v threadtime -f /cache/logcat.txt
    class main
    user root
    group root log
    seclabel u:r:su:s0
    disabled

on property:sys.usb.config=adb && property:sys.usb.configfs=1
    start adbd

service health-interface-provider /vendor/bin/hw/android.hardware.health@2.1-service-samsung
    class core
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    interface android.hardware.health@2.1::IHealth default
    interface android.hardware.health@2.0::IHealth default

service boot_dmesg /system/bin/sh -c "/system/bin/dmesg -w > /metadata/bootlogs/dmesg.txt"
    class core
    user root
    group root
    seclabel u:r:init:s0
    disabled

service boot_logcat /system/bin/logcat -b main,system,crash -f /metadata/bootlogs/logcat.txt -r 20480 -n 3 auditd:S *:I
    class core
    user root
    group root
    seclabel u:r:init:s0
    disabled

on property:sys.boot_completed=1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb
    start adbd
    exec u:r:su:s0 root root -- /vendor/bin/secril_config_svc SimConfig
    exec u:r:su:s0 root root -- /vendor/bin/secril_config_svc NetworkConfig
    start vendor.netmgrd
    start vendor.ipacm
    start ril-daemon
    exec u:r:su:s0 root root -- /system/bin/sh /system/bin/init.q2q.ims.sh
    restart audioserver
    exec_background u:r:su:s0 root root -- /system/bin/sh -c "sleep 2; if ! /system/bin/cmd device_state print-state 2>/dev/null | grep -qx 0; then /system/bin/cmd device_state state 0 && sleep 1.5 && /system/bin/cmd device_state state reset; fi"
    exec_background u:r:su:s0 root root -- /system/bin/sh /system/bin/init.q2q.storage.sh
    write /sys/class/usb_notify/usb_control/usb_sl SUNNY_WORK_MODE

# Repair emulated storage only after user 0's encrypted storage is available.
on property:sys.user.0.ce_available=true
    start q2q_storage_repair

service q2q_storage_repair /system/bin/sh /system/bin/init.q2q.storage.sh
    class late_start
    user root
    group root
    disabled
    oneshot
    seclabel u:r:su:s0

# q2q_bt_audio_service is now hosted in-process inside vendor.audio-hal via libq2q_hidl_shim.so
# so audio.bluetooth.default.so and android.hardware.bluetooth.audio-impl.so share
# libbluetooth_audio_session_aidl.so state.

service display-allocator-provider /vendor/bin/hw/vendor.qti.hardware.display.allocator-service
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    interface android.hardware.graphics.allocator@4.0::IAllocator default
    interface android.hardware.graphics.allocator@3.0::IAllocator default
    interface android.hardware.graphics.allocator@2.0::IAllocator default

service display-composer-provider /vendor/bin/hw/vendor.qti.hardware.display.composer-service
    class hal animation
    user system
    group graphics drmrpc
    capabilities SYS_NICE SYS_RESOURCE SYS_ADMIN SYS_RAWIO
    onrestart restart surfaceflinger
    socket pps stream 0660 system system
    interface android.hardware.graphics.composer@2.4::IComposer default
    interface android.hardware.graphics.composer@2.3::IComposer default
    interface android.hardware.graphics.composer@2.2::IComposer default
    interface android.hardware.graphics.composer@2.1::IComposer default

on property:sys.usb.config=none
    setprop sys.usb.config adb
    start adbd
